# Copy this file to .env.local and fill in a real value before deploying.
#
# The URL the contact form POSTs JSON to. See the comment at the top of
# src/lib/contactApi.ts for wiring options (Formspree, Resend + a serverless
# function, or a custom API route). When this is unset, form submissions are
# logged to the console and resolved after a simulated delay — safe for local
# development, never fine for production.
VITE_CONTACT_ENDPOINT=
